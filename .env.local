# =======================================================
# GENERAL APPLICATION SETTINGS
# =======================================================
# Defines the environment mode (local/production)
APP_ENV=local

# The public URL of the React Frontend
APP_URL=http://localhost

# The public URL of the Spring Boot Backend
API_URL=http://localhost:8080

# =======================================================
# NETWORK & PROXY SETTINGS
# =======================================================
# These are left empty for local development to bypass any corporate proxies.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
# Maven options for building the backend (empty locally)
MAVEN_OPTS=

# =======================================================
# NGINX CONFIGURATION
# =======================================================
# Selects the simple HTTP configuration file for localhost (no SSL)
NGINX_CONF_FILE=localhost.conf

# =======================================================
# KEYCLOAK (IAM) CONFIGURATION
# =======================================================
# The realm name to create/use in Keycloak
KEYCLOAK_REALM_NAME=rea-realm

# Admin credentials for the Keycloak Management Console
# Used by the backend to create users/roles programmatically
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# The JSON file to import on startup (contains the 'rea-frontend' client config)
KC_REALM_FILE=realm-config-local.json

# The public URL for Keycloak authentication (Port 9080 mapped in Docker)
KC_HOSTNAME=http://localhost:9080/auth

# =======================================================
# OIDC CLIENT CONFIGURATION (BACKEND)
# =======================================================
# These credentials allow the Spring Boot Backend to validate tokens
# and communicate with Keycloak.
REA_BACKEND_CLIENT_ID=rea-backend
REA_BACKEND_CLIENT_SECRET=api-client-secret

# =======================================================
# DATABASE CONFIGURATION (POSTGRESQL)
# =======================================================
# Credentials for the PostgreSQL database container
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB_NAME=riskdb

# =======================================================
# SPRING BOOT SPECIFIC SETTINGS
# =======================================================
# 'update': Updates the DB schema without deleting data (Safe for restarts)
# 'create-drop': Drops and recreates the DB schema on every restart (Good for fresh testing)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Force updates of JSON config files into the DB on startup
APP_SETUP_LOAD_SAMPLE_DATA=true
APP_SETUP_UPDATE_THRESHOLDS=true
APP_SETUP_UPDATE_QUESTIONS=true
