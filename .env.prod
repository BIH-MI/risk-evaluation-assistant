# =======================================================
# GENERAL APPLICATION SETTINGS
# =======================================================
APP_ENV=production

# The public HTTPS URL of the application
APP_URL=
API_URL=

# =======================================================
# NETWORK & PROXY SETTINGS
# =======================================================
# Configures the application to route traffic through the proxy
HTTP_PROXY=
HTTPS_PROXY=

# Hosts that should NOT be accessed via the proxy (Internal Docker networks)
NO_PROXY=

# Passes proxy settings specifically to the Maven build process
MAVEN_OPTS=

# =======================================================
# NGINX CONFIGURATION
# =======================================================
# Selects the production configuration file (Handles SSL/HTTPS)
NGINX_CONF_FILE=default.conf

# =======================================================
# KEYCLOAK (IAM) CONFIGURATION
# =======================================================
KEYCLOAK_REALM_NAME=rea-realm

# !SECURITY WARNING! Change these to secure passwords in actual production
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Imports the production realm configuration (with HTTPS redirect URIs)
KC_REALM_FILE=realm-config.json
KC_HOSTNAME=

# =======================================================
# OIDC CLIENT CONFIGURATION (BACKEND)
# =======================================================
REA_BACKEND_CLIENT_ID=rea-backend
REA_BACKEND_CLIENT_SECRET=api-client-secret

# =======================================================
# DATABASE CONFIGURATION (POSTGRESQL)
# =======================================================
# !SECURITY WARNING! Change these to secure passwords in actual production
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB_NAME=riskdb

# =======================================================
# SPRING BOOT SPECIFIC SETTINGS
# =======================================================
# 'update': Prevents data loss by only updating the schema
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Force updates of JSON config files into the DB on startup
APP_SETUP_LOAD_SAMPLE_DATA=true
APP_SETUP_UPDATE_THRESHOLDS=true
APP_SETUP_UPDATE_QUESTIONS=true
