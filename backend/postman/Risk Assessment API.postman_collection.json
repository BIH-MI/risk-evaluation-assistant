						"body": {
							"mode": "raw",
							"raw": "{\n  \"datasetId\": 1,\n  \"name\": \"Compliance Check 2024\",\n  \"keyThreshold\": 0.05,\n  \"sensitiveThreshold\": 0.03,\n  \"generalComments\": \"Initial thresholds set following Q1 review.\",\n  \"raAttributes\": \n    [\n        {\n            \"newOrder\": 1,\n            \"name\": \"Age\",\n            \"category\": \"Demographic\",\n            \"dataType\": \"Integer\",\n            \"explicitlyAddressedInGuidelines\": true,\n            \"sensitivity\": 0.9,\n            \"replicability\": 1.0,\n            \"availability\": 1.0,\n            \"distinguishability\": 0.5,\n            \"sum\": 45.0,\n            \"isKey\": false,\n            \"isDirectIdentifier\": false,\n            \"isSensitiveVariable\": true,\n            \"commentsRegardingIdentifiability\": \"Age can be sensitive when combined with other demographic data.\",\n            \"commentsRegardingSensitivity\": \"Highly sensitive in contexts where age discrimination is a risk.\",\n            \"generalComments\": \"Used widely in all demographic studies.\"\n        },\n        {\n            \"newOrder\": 2,\n            \"name\": \"Blood Type\",\n            \"category\": \"Medical\",\n            \"dataType\": \"String\",\n            \"explicitlyAddressedInGuidelines\": false,\n            \"sensitivity\": 0.8,\n            \"replicability\": 1.0,\n            \"availability\": 0.8,\n            \"distinguishability\": 0.2,\n            \"sum\": 20.0,\n            \"isKey\": false,\n            \"isDirectIdentifier\": false,\n            \"isSensitiveVariable\": false,\n            \"commentsRegardingIdentifiability\": \"Blood type alone does not identify individuals but is critical for medical procedures.\",\n            \"commentsRegardingSensitivity\": \"Generally not sensitive unless specifically related to health conditions.\",\n            \"generalComments\": \"Essential for transfusions and other medical treatments.\"\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
