# =======================================================
# LOCAL DEVELOPMENT CONFIGURATION (npm start)
# =======================================================
# These settings are ONLY used when running 'npm start' directly.
# They are ignored when running via Docker (docker-compose).

# Connect directly to the Spring Boot container port (bypassing Nginx)
REACT_APP_API_URL=http://localhost:8080

# =======================================================
# OIDC / KEYCLOAK SETTINGS
# =======================================================
# Connect directly to the Keycloak container port
REACT_APP_OIDC_AUTHORITY=http://localhost:9080/auth/realms/rea-realm

# The Client ID configured in Keycloak for the Frontend
REACT_APP_OIDC_CLIENT_ID=rea-frontend

# Redirect back to the local React dev server (Port 3000)
REACT_APP_OIDC_REDIRECT_URI=http://localhost:3000/
REACT_APP_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/